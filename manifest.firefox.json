{
  "manifest_version": 3,
  "name": "0FluffCapture",
  "version": "0.1.0",
  "description": "A lightweight browser extension for quickly saving the current tab to your 0FluffStart dashboard.",
  "permissions": ["activeTab"],
  "browser_specific_settings": {
    "gecko": {
      "id": "0fluff-capture@jbuilds.local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Save to 0FluffStart",
    "default_popup": "popup.html"
  }
}
